---
/**
 * BaseLayout.astro — Antocarz
 * Layout base con SEO completo, Schema JSON-LD y OG tags.
 */

import { SITE } from '../content/site';
import { FAQ_ITEMS } from '../content/faq';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import '../styles/animations.css';

export interface BaseLayoutProps {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  canonicalUrl = SITE.url,
  noIndex = false,
} = Astro.props as BaseLayoutProps;

const schemaLocalBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoPartsStore',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.location.address,
    addressLocality: SITE.location.city,
    addressRegion: SITE.location.region,
    addressCountry: SITE.location.country,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '09:30', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:30', closes: '14:00' },
  ],
  areaServed: [
    { '@type': 'City', name: 'La Serena' },
    { '@type': 'City', name: 'Coquimbo' },
    { '@type': 'City', name: 'Ovalle' },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.7',
    bestRating: '5',
    worstRating: '1',
    ratingCount: '223',
  },
  sameAs: [
    SITE.social.instagram,
    SITE.social.facebook,
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Seguridad Automotriz',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Polarizado Nanocarbón Legal Certificado La Serena' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Láminas de Seguridad Anti-impactos para Vehículos' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Rastreadores GPS Antirrobo La Serena — Rastreadores.cl' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Alarmas y Cortacorriente Eléctrico para Autos — Inmovilizador RFID' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Instalación de Radio Android con CarPlay y GPS' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Aire Acondicionado Automotriz La Serena' } },
    ],
  },
  priceRange: '$$',
  inLanguage: 'es-CL',
};

const schemaFAQPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="es-CL" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="gwuXaEyJImHdmJjQPsKvbeXsrXmJjXwylFPVS59Q7hw" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Analytics -->
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.url}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og-image.jpg`} />

    <!-- Local SEO -->
    <meta name="geo.region" content="CL-CO" />
    <meta name="geo.placename" content="La Serena, Chile" />
    <meta name="geo.position" content="-29.9027;-71.2519" />
    <meta name="ICBM" content="-29.9027, -71.2519" />

    <!-- Keywords SEO -->
    <meta name="keywords" content="seguridad automotriz La Serena, cortacorriente auto La Serena, corta corriente vehículo, cortacorriente eléctrico auto, polarizado nanocarbón La Serena, certificado polarizado La Serena, cómo sacar certificado polarizado, láminas de seguridad auto, láminas anti-impactos vehículos, rastreadores GPS antirrobo La Serena, inmovilizador RFID auto, seguridad vehicular Coquimbo, alarmas homologadas La Serena, car audio La Serena, radio android CarPlay La Serena, Android Auto La Serena, aire acondicionado automotriz La Serena, ZTAudio, rastreadores.cl, antocarz" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload primera imagen hero (LCP) -->
    <link rel="preload" as="image" href="/slides hero/oferta-septiembre-1.webp" />

    <!-- Preconnect al servidor de imágenes de productos -->
    <link rel="preconnect" href="https://antocarz.cl" />
    <link rel="dns-prefetch" href="https://antocarz.cl" />

    <!-- Google Fonts: Lato — carga no bloqueante -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet" /></noscript>

    <!-- Schema JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQPage)} />

    <meta name="theme-color" content="#0D0D0D" />

    <!-- Prevenir flash de tema incorrecto (inline, no module) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('antocarz-theme');
        if (saved === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body>
    <!-- Efecto Difuminado Global de Rejilla -->
    <div class="bg-hazard-glow"></div>
    
    <!-- Marca de agua gigante y sutil del logo (el perro) -->
    <div class="bg-dog-watermark"></div>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import { initScrollReveal } from '../utils/animations';
      setTimeout(() => initScrollReveal(), 300);

      // ── Analytics: WhatsApp click tracking ───────────────────────────────
      function fireEvent(name: string, params: Record<string, string>) {
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', name, params);
        }
      }

      function getWaSource(element: Element): string {
        const explicit = (element as HTMLElement).dataset.waSource;
        if (explicit) return explicit;
        const section = element.closest('section[id]');
        if (section) return (section as HTMLElement).id;
        if (element.closest('header')) return 'header';
        if (element.closest('footer')) return 'footer';
        return 'unknown';
      }

      document.querySelectorAll('a[href*="wa.me"]').forEach(link => {
        link.addEventListener('click', () => {
          const source = getWaSource(link);
          fireEvent('whatsapp_click', {
            event_category: 'conversion',
            wa_source: source || 'unknown',
            wa_branch: 'bot',
          });
        });
      });
    </script>
  </body>
</html>
