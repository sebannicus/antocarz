---
/**
 * NavidadCountdown.astro — Antocarz · Campaña Navidad 2026
 * Contador regresivo a Navidad (CHRISTMAS_AT en campaign.ts).
 *  - variant="full":    cuatro cajas Días / Horas / Min / Seg.
 *  - variant="compact": una línea para el badge del Hero.
 * Desde el 25-dic muestra "¡Feliz Navidad!" en vez de ceros.
 * Un solo setInterval actualiza todas las instancias de la página.
 */
import { CHRISTMAS_AT } from '../../../content/campaign';

export interface Props {
  variant?: 'full' | 'compact';
  class?: string;
}
const { variant = 'full', class: className } = Astro.props as Props;
const units = [
  { key: 'd', label: 'Días' },
  { key: 'h', label: 'Horas' },
  { key: 'm', label: 'Min' },
  { key: 's', label: 'Seg' },
];
---

{variant === 'full' ? (
  <div class:list={['xm-countdown', className]} data-xm-countdown={CHRISTMAS_AT} role="timer" aria-label="Cuenta regresiva para Navidad">
    <div class="xm-countdown__grid">
      {units.map((u) => (
        <div class="xm-countdown__unit">
          <span class="xm-countdown__num" data-unit={u.key}>--</span>
          <span class="xm-countdown__label">{u.label}</span>
        </div>
      ))}
    </div>
    <p class="xm-countdown__done">¡Feliz Navidad! 🎄</p>
  </div>
) : (
  <span class:list={['xm-countdown-compact', className]} data-xm-countdown={CHRISTMAS_AT}>
    <span class="xm-countdown-compact__live">
      Faltan <b data-unit="d">--</b> días <b data-unit="h">--</b>:<b data-unit="m">--</b>:<b data-unit="s">--</b>
    </span>
    <span class="xm-countdown__done">¡Feliz Navidad!</span>
  </span>
)}

<script>
  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-xm-countdown]'));
  if (roots.length && document.documentElement.dataset.campaign === 'navidad') {
    const pad = (n: number) => String(n).padStart(2, '0');
    const update = () => {
      for (const root of roots) {
        const diff = Date.parse(root.dataset.xmCountdown || '') - Date.now();
        if (Number.isNaN(diff)) continue;
        if (diff <= 0) {
          root.classList.add('is-done');
          continue;
        }
        const s = Math.floor(diff / 1000);
        const values: Record<string, string> = {
          d: String(Math.floor(s / 86400)),
          h: pad(Math.floor((s % 86400) / 3600)),
          m: pad(Math.floor((s % 3600) / 60)),
          s: pad(s % 60),
        };
        root.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
          const v = values[el.dataset.unit || ''];
          if (v !== undefined && el.textContent !== v) el.textContent = v;
        });
      }
    };
    update();
    setInterval(update, 1000);
  }
</script>

<style>
  .xm-countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 16px);
  }
  .xm-countdown__unit {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: clamp(12px, 2.4vw, 20px) 6px;
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgba(246, 217, 133, 0.10), rgba(142, 27, 51, 0.18)),
      rgba(10, 29, 20, 0.7);
    border: 1px solid rgba(226, 184, 75, 0.32);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 10px 30px rgba(2, 10, 6, 0.45);
  }
  .xm-countdown__num {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    color: #F6D985;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 22px rgba(226, 184, 75, 0.45);
  }
  .xm-countdown__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .xm-countdown__done { display: none; }
  .xm-countdown.is-done .xm-countdown__grid { display: none; }
  .xm-countdown.is-done .xm-countdown__done {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 6vw, 3rem);
    font-style: italic;
    color: #F6D985;
    text-align: center;
  }

  .xm-countdown-compact { font-variant-numeric: tabular-nums; }
  .xm-countdown-compact b { font-weight: 900; color: #FFFFFF; }
  .xm-countdown-compact.is-done .xm-countdown-compact__live { display: none; }
  .xm-countdown-compact.is-done .xm-countdown__done { display: inline; }
</style>
