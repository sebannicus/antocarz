---
/**
 * NavidadAtmosphere.astro — Antocarz · Campaña Navidad 2026
 * Capa global de la campaña. Responsabilidades:
 *  1. Cargar el tema visual (tokens + overrides) — navidad.css.
 *  2. Publicar como variables CSS las ilustraciones que el CSS usa como
 *     background (regalos, nieve acumulada) — una sola fuente: shapes.ts.
 *  3. Fondo cálido fijo detrás de todo el sitio.
 *  4. Nieve en <canvas> (liviana, se pausa con la pestaña oculta y no corre
 *     con prefers-reduced-motion).
 *
 * Se renderiza desde BaseLayout solo si la campaña está habilitada; aun así,
 * nada se ve ni corre si <html> no tiene data-campaign="navidad".
 */
import '../../../styles/themes/navidad.css';
import { XMAS, giftSvg } from './shapes';

const dataUri = (svg: string) => `url("data:image/svg+xml,${encodeURIComponent(svg.replace(/\s+/g, ' '))}")`;

const SNOWCAP = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 18"><path d="M0 18V9Q10 1 22 6t24-1q14-6 26 2t26-1q14-6 28 1t26-2q14-5 26 3t26-2q14-6 26 1t10 1V18z" fill="#F2F6F3"/></svg>`;
const withNs = (svg: string) => svg.replace('<svg ', '<svg xmlns="http://www.w3.org/2000/svg" ');

const vars = [
  `--xm-gift-red:${dataUri(withNs(giftSvg(XMAS.red, XMAS.gold)))}`,
  `--xm-gift-green:${dataUri(withNs(giftSvg(XMAS.pineLight, XMAS.cream)))}`,
  `--xm-gift-gold:${dataUri(withNs(giftSvg(XMAS.gold, XMAS.burgundy)))}`,
  `--xm-snowcap:${dataUri(SNOWCAP)}`,
].join(';');
const varsCss = `html[data-campaign="navidad"]{${vars}}`;
---

<style is:inline set:html={varsCss}></style>

<div class="xm-atmosphere" aria-hidden="true"></div>
<canvas class="xm-snow" aria-hidden="true"></canvas>

<script>
  const html = document.documentElement;
  const isLive = html.dataset.campaign === 'navidad';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.querySelector<HTMLCanvasElement>('.xm-snow');

  if (isLive && !reducedMotion && canvas) {
    const ctx = canvas.getContext('2d');
    type Flake = { x: number; y: number; r: number; vy: number; phase: number; sway: number; a: number };
    let flakes: Flake[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;

    const spawn = (anywhere: boolean): Flake => ({
      x: Math.random() * w,
      y: anywhere ? Math.random() * h : -6,
      r: 0.8 + Math.random() * 2.2,
      vy: 0.35 + Math.random() * 0.9,
      phase: Math.random() * Math.PI * 2,
      sway: 0.3 + Math.random() * 0.7,
      a: 0.35 + Math.random() * 0.5,
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = w < 768 ? 36 : 85;
      flakes = Array.from({ length: target }, () => spawn(true));
    };

    const tick = (t: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      for (const f of flakes) {
        f.y += f.vy;
        f.x += Math.sin(t / 1600 + f.phase) * f.sway * 0.6;
        if (f.y > h + 6) Object.assign(f, spawn(false));
        ctx.globalAlpha = f.a;
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx.fillStyle = '#FFFFFF';
        ctx.fill();
      }
      raf = requestAnimationFrame(tick);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(tick);
    });
    raf = requestAnimationFrame(tick);
  }
</script>

<style>
  .xm-atmosphere,
  .xm-snow { display: none; }

  :global(html[data-campaign="navidad"]) .xm-atmosphere {
    display: block;
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 45% at 15% 0%, rgba(226, 184, 75, 0.10) 0%, transparent 65%),
      radial-gradient(ellipse 60% 50% at 100% 100%, rgba(142, 27, 51, 0.16) 0%, transparent 65%),
      radial-gradient(ellipse 40% 30% at 50% 50%, rgba(31, 90, 58, 0.18) 0%, transparent 70%),
      #0A1D14;
  }

  :global(html[data-campaign="navidad"]) .xm-snow {
    display: block;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Sobre el contenido pero bajo el header; nunca intercepta clics. */
    z-index: calc(var(--z-header) - 1);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-campaign="navidad"]) .xm-snow { display: none; }
  }
</style>
