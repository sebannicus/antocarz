---
/**
 * Brands.astro — Antocarz
 * Logos de marcas que instalan en marquee infinito.
 * Logos *-blanco.webp: versión con texto blanco para el fondo oscuro.
 * h: altura en px ajustada al ancho de cada logo para igualar su peso visual.
 */

const brands = [
  { name: 'ZTAudio',          src: '/logos/ztaudio.webp',           w: 73, h: 44, href: '/ztaudio' },
  { name: 'JBL',              src: '/logos/jbl.webp',               w: 52, h: 44, href: '/ztaudio' },
  { name: 'Pioneer',          src: '/logos/pioneer.webp',           w: 181, h: 27, href: '/ztaudio' },
  { name: 'Kenwood',          src: '/logos/kenwood-blanco.webp',    w: 171, h: 28, href: '/ztaudio' },
  { name: 'Hertz',            src: '/logos/hertz-blanco.webp',      w: 136, h: 35, href: '/ztaudio' },
  { name: 'Hawk',             src: '/logos/hawk-blanco.webp',       w: 126, h: 38 },
  { name: 'K-9 Car Alarm',    src: '/logos/k9.webp',                w: 71, h: 44 },
  { name: 'rastreadores.cl',  src: '/logos/rastreadores.webp',      w: 131, h: 37 },
  { name: 'GPS Autorastreo',  src: '/logos/gps-autorastreo.webp',   w: 139, h: 34 },
];

// 4 copias: el keyframe marquee desplaza -50% (= 2 copias exactas), así el loop
// no salta y cubre pantallas anchas.
const items = [...brands, ...brands, ...brands, ...brands];
---

<section class="brands" aria-label="Marcas que instalamos">
  <div class="container">
    <p class="brands__label">Marcas que instalamos</p>
  </div>

  <div class="brands__marquee marquee">
    <div class="marquee__track">
      {items.map((b) => {
        const logo = (
          <img
            src={b.src}
            alt={b.name}
            width={b.w}
            height={b.h}
            style={`height: ${b.h}px`}
            class="brands__logo"
            loading="lazy"
            draggable="false"
          />
        );
        return b.href
          ? <a href={b.href} class="brands__link" aria-label={`${b.name} — ver línea de audio ZTAudio`}>{logo}</a>
          : logo;
      })}
    </div>
  </div>
</section>

<style>
  .brands {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-surface);
    overflow: hidden;
  }

  .brands__label {
    text-align: center;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .brands__marquee .marquee__track {
    animation-duration: 40s;
  }

  .brands__logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    opacity: 0.85;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
    border-radius: 4px;
  }

  .brands__link {
    display: inline-flex;
    flex-shrink: 0;
  }

  .brands__logo:hover {
    opacity: 1;
  }

  .marquee__track {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }
</style>
