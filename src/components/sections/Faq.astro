---
/**
 * Faq.astro — Antocarz
 * Preguntas frecuentes con tabs por categoría y acordeón accesible.
 * Doble valor: UX + Schema FAQPage para SEO.
 */

import SectionLabel from '../ui/SectionLabel.astro';
import { FAQ_ITEMS, FAQ_CATEGORIES } from '../../content/faq';

const byCategory = FAQ_CATEGORIES.map((cat) => ({
  label: cat,
  id: cat.toLowerCase().replace(/\s+/g, '-').replace(/[áéíóú]/g, (c: string) =>
    ({ á: 'a', é: 'e', í: 'i', ó: 'o', ú: 'u' } as Record<string, string>)[c] ?? c
  ),
  items: FAQ_ITEMS.filter((f) => f.category === cat),
}));
---

<section class="faq section section--overlay" id="faq" aria-labelledby="faq-heading">
  <div class="container container--sm">
    <div class="faq__header" data-scroll-children>
      <SectionLabel text="PREGUNTAS FRECUENTES" align="center" />
      <h2 class="faq__title" id="faq-heading">
        ¿Tienes dudas?<br />
        <span class="text-gradient-gold">Te respondemos.</span>
      </h2>
    </div>

    <details class="faq__outer">
      <summary class="faq__outer-summary">
        <span>Ver preguntas frecuentes</span>
        <span class="faq__outer-icon" aria-hidden="true">+</span>
      </summary>

      <!-- Category tabs -->
      <div class="faq__tabs-wrap">
        <div class="faq__tabs" role="tablist" aria-label="Categorías de preguntas">
          {byCategory.map(({ label, id }, i) => (
            <button
              class={`faq__tab${i === 0 ? ' faq__tab--active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`faq-panel-${id}`}
              data-tab={id}
            >
              {label}
            </button>
          ))}
        </div>
      </div>

      <!-- Panels per category -->
      {byCategory.map(({ label, id, items }, i) => (
        <div
          class={`faq__panel${i === 0 ? ' faq__panel--active' : ''}`}
          role="tabpanel"
          id={`faq-panel-${id}`}
          aria-label={label}
          hidden={i !== 0}
        >
          <div class="faq__list">
            {items.map((item) => (
              <details class="faq__item" name={`faq-${id}`}>
                <summary class="faq__question">
                  <span>{item.question}</span>
                  <span class="faq__icon" aria-hidden="true">+</span>
                </summary>
                <div class="faq__answer">
                  {item.answerHtml
                    ? <Fragment set:html={item.answerHtml} />
                    : <p>{item.answer}</p>
                  }
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </details>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.faq__tab');
  const panels = document.querySelectorAll<HTMLElement>('.faq__panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;

      tabs.forEach((t) => {
        t.classList.toggle('faq__tab--active', t === tab);
        t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const active = panel.id === `faq-panel-${target}`;
        panel.classList.toggle('faq__panel--active', active);
        if (active) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
          // close all open items in hidden panels
          panel.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((d) => d.removeAttribute('open'));
        }
      });
    });
  });
</script>

<style>
  /* ── Fondo Difuminado Rojo ── */
  .faq {
    background: radial-gradient(circle at center, rgba(227, 6, 19, 0.06) 0%, var(--color-bg-overlay) 70%);
  }

  .faq__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .faq__title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
  }

  .faq__outer {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .faq__outer[open] {
    border-color: var(--color-border-hover);
  }

  .faq__outer-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    font-family: var(--font-subhead);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-gold);
    list-style: none;
    user-select: none;
    background: var(--color-bg-surface);
    transition: color var(--transition-fast);
  }

  .faq__outer-summary::-webkit-details-marker { display: none; }
  .faq__outer-summary:hover { color: var(--color-text-primary); }

  .faq__outer-icon {
    font-size: var(--text-2xl);
    flex-shrink: 0;
    transition: transform var(--transition-base);
    line-height: 1;
  }

  .faq__outer[open] .faq__outer-icon {
    transform: rotate(45deg);
  }

  /* ── Tabs ── */
  .faq__tabs-wrap {
    background: var(--color-bg-overlay);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .faq__tabs-wrap::-webkit-scrollbar { display: none; }

  .faq__tabs {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4);
    white-space: nowrap;
  }

  .faq__tab {
    flex-shrink: 0;
    padding: var(--space-2) var(--space-4);
    border-radius: 50px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    font-family: var(--font-subhead);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .faq__tab:hover {
    border-color: var(--color-gold);
    color: var(--color-text-primary);
  }

  .faq__tab--active {
    border-color: var(--color-gold);
    background: rgba(201, 162, 39, 0.12);
    color: var(--color-gold);
  }

  /* ── Panels ── */
  .faq__panel {
    display: none;
  }

  .faq__panel--active {
    display: block;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-overlay);
  }

  .faq__item {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-base);
  }

  .faq__item[open] {
    border-color: var(--color-border-hover);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    font-family: var(--font-subhead);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    list-style: none;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .faq__question::-webkit-details-marker { display: none; }
  .faq__question:hover { color: var(--color-gold); }

  .faq__icon {
    font-size: var(--text-xl);
    color: var(--color-gold);
    flex-shrink: 0;
    transition: transform var(--transition-base);
    line-height: 1;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 var(--space-6) var(--space-5);
  }

  .faq__answer p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .faq__list-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .faq__list-items li::marker {
    color: var(--color-gold);
  }

  .faq__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    overflow-x: auto;
    display: block;
  }

  .faq__table th,
  .faq__table td {
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    text-align: center;
  }

  .faq__table th {
    background: var(--color-bg-overlay);
    color: var(--color-gold);
    font-weight: var(--weight-semibold);
    font-size: var(--text-xs);
  }

  .faq__table td:first-child {
    text-align: left;
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
  }
</style>
