---
/**
 * verificador.astro — Antocarz
 * Verificador de certificado de instalación (polarizado / láminas de seguridad).
 * Reemplaza el redirect anterior a sistema.antocarz.cl/verificador.php con una
 * versión nativa integrada al diseño del sitio. Consulta un endpoint PHP propio
 * (verificar-certificado.php) que lee la misma tabla anto_certificados del ERP;
 * la descarga del PDF final sigue generándose en sistema.antocarz.cl (FPDF ya probado).
 */
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../content/site';

const title = 'Verifica tu Certificado de Instalación | Antocarz';
const description = 'Verifica en línea tu certificado de polarizado o láminas de seguridad Antocarz. Ingresa tu patente y RUT para descargar tu certificado digital.';

const API = 'https://api.antocarz.cl/api/verificar-certificado.php?key=antocarz_api_2026';
const DOWNLOAD_BASE = 'https://sistema.antocarz.cl/inc/inf_certificado.php';

const whatsappMsg = encodeURIComponent('Hola Antocarz 👋 No encontré mi certificado en el verificador de la web. ¿Me pueden ayudar?');
const whatsappUrl = `https://wa.me/${SITE.whatsapp}?text=${whatsappMsg}`;
---

<BaseLayout title={title} description={description}>
  <section class="verif section" id="verificador" aria-labelledby="verif-heading">
    <div class="container container--narrow">
      <div class="verif__header gs-fade-up">
        <SectionLabel text="CERTIFICADO DIGITAL" />
        <h1 class="verif__title" id="verif-heading">
          Verifica tu <span class="text-gradient-gold">certificado</span>
        </h1>
        <p class="verif__desc">
          Ingresa la patente de tu vehículo para buscar tus certificados de polarizado o láminas de seguridad emitidos por Antocarz.
        </p>
      </div>

      <div class="verif__card gs-slide-up">
        <form id="formPatente" class="verif__form" autocomplete="off">
          <label for="patente" class="verif__label">Patente del vehículo</label>
          <div class="verif__input-row">
            <input
              type="text"
              id="patente"
              name="patente"
              class="verif__input"
              placeholder="AABB11"
              maxlength="8"
              required
            />
            <Button type="submit" variant="primary" size="md">Buscar</Button>
          </div>
        </form>

        <div id="verifState" class="verif__state" aria-live="polite"></div>
        <div id="verifResults" class="verif__results"></div>
      </div>

      <p class="verif__help">
        ¿No encuentras tu certificado?
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .verif { padding-top: 120px; min-height: 70vh; }
  .container--narrow { max-width: 640px; }

  .verif__header { text-align: center; margin-bottom: var(--space-10); }
  .verif__title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    margin-block: var(--space-4);
    line-height: var(--leading-tight);
  }
  .verif__desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 480px;
    margin-inline: auto;
  }

  .verif__card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
  }

  .verif__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .verif__input-row {
    display: flex;
    gap: var(--space-3);
  }

  .verif__input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .verif__input:focus {
    border-color: var(--color-gold);
    box-shadow: 0 0 0 1px var(--color-gold);
  }

  .verif__state {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-align: center;
    min-height: 1px;
  }
  .verif__state--error { color: #ff6b6b; }

  .verif__results {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.verif-item) {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgba(255,255,255,0.02);
  }

  :global(.verif-item__title) {
    font-family: var(--font-headline);
    font-weight: var(--weight-bold);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  :global(.verif-item__meta) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  :global(.verif-item__rut-row) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }

  :global(.verif-item__rut-input) {
    flex: 1;
    min-width: 160px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    outline: none;
  }
  :global(.verif-item__rut-input:focus) {
    border-color: var(--color-gold);
  }

  :global(.verif-item__msg) {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  :global(.verif-item__msg--ok) { color: #2ECC71; }
  :global(.verif-item__msg--error) { color: #ff6b6b; }

  .verif__help {
    text-align: center;
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .verif__help a { color: var(--color-gold); font-weight: var(--weight-semibold); }

  /* Los elementos de .verif-item se inyectan via innerHTML en el cliente, así que
     no reciben el atributo de scope de Astro: los estilos de Button.astro no les
     llegan y hay que declararlos como :global aquí (mismo patrón que productos.astro). */
  :global(.verif-item button) {
    flex-shrink: 0;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-hover);
    background: rgba(201, 162, 39, 0.12);
    color: var(--color-gold);
    font-family: var(--font-subhead);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }
  :global(.verif-item button:hover) {
    background: rgba(201, 162, 39, 0.22);
    transform: translateY(-1px);
  }
  :global(.verif-item button:disabled) {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }
</style>

<script define:vars={{ API, DOWNLOAD_BASE }}>
  const form = document.getElementById('formPatente');
  const patenteInput = document.getElementById('patente');
  const stateEl = document.getElementById('verifState');
  const resultsEl = document.getElementById('verifResults');

  function setState(msg, isError) {
    stateEl.textContent = msg || '';
    stateEl.classList.toggle('verif__state--error', !!isError);
  }

  function fmtVigencia(iso) {
    if (!iso) return 'No disponible';
    const [y, m, d] = iso.split('-');
    return `${d}/${m}/${y}`;
  }

  function buildResultItem(cert) {
    const wrap = document.createElement('div');
    wrap.className = 'verif-item';
    wrap.innerHTML = `
      <p class="verif-item__title">${cert.tipo} · N° ${cert.numeracion ?? cert.id}</p>
      <p class="verif-item__meta">Patente ${cert.patente} · Vigente hasta ${fmtVigencia(cert.vigenciaHasta)}</p>
      <div class="verif-item__rut-row">
        <input type="text" class="verif-item__rut-input" placeholder="Tu RUT (ej: 11111111-1)" />
        <button type="button" class="btn btn--secondary btn--sm">Verificar y descargar</button>
      </div>
      <div class="verif-item__msg" aria-live="polite"></div>
    `;

    const rutInput = wrap.querySelector('.verif-item__rut-input');
    const btn = wrap.querySelector('button');
    const msgEl = wrap.querySelector('.verif-item__msg');

    btn.addEventListener('click', async () => {
      const rut = rutInput.value.trim();
      if (!rut) {
        msgEl.textContent = 'Ingresa tu RUT para continuar.';
        msgEl.className = 'verif-item__msg verif-item__msg--error';
        return;
      }
      btn.disabled = true;
      msgEl.textContent = 'Verificando…';
      msgEl.className = 'verif-item__msg';
      try {
        const res = await fetch(`${API}&action=verificar&id=${cert.id}&rut=${encodeURIComponent(rut)}`);
        const data = await res.json();
        if (data.valid) {
          msgEl.textContent = 'RUT verificado. Descargando…';
          msgEl.className = 'verif-item__msg verif-item__msg--ok';
          window.location.href = `${DOWNLOAD_BASE}?val=${cert.id}`;
        } else {
          msgEl.textContent = 'El RUT no coincide con este certificado.';
          msgEl.className = 'verif-item__msg verif-item__msg--error';
        }
      } catch (e) {
        msgEl.textContent = 'No se pudo verificar. Intenta nuevamente.';
        msgEl.className = 'verif-item__msg verif-item__msg--error';
      } finally {
        btn.disabled = false;
      }
    });

    return wrap;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    resultsEl.innerHTML = '';
    const patente = patenteInput.value.trim();
    if (!patente) return;

    setState('Buscando…');
    try {
      const res = await fetch(`${API}&action=buscar&patente=${encodeURIComponent(patente)}`);
      const data = await res.json();
      if (Array.isArray(data) && data.length > 0) {
        setState('');
        data.forEach((cert) => resultsEl.appendChild(buildResultItem(cert)));
      } else {
        setState(`No encontramos certificados para la patente ${patente.toUpperCase()}.`, true);
      }
    } catch (e) {
      setState('No se pudo conectar con el verificador. Intenta nuevamente en unos minutos.', true);
    }
  });
</script>
