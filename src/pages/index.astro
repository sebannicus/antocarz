---
/**
 * index.astro — Antocarz
 * Página principal. Solo orquesta secciones — sin lógica de negocio.
 * Estructura: Hero → Authority → Brands → Services → CertificadoPolarizado → Differentiator → Products → Testimonials → FAQ → LocalMap → CtaFinal
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import PromoBanner from '../components/sections/PromoBanner.astro';
import Authority from '../components/sections/Authority.astro';
import Brands from '../components/sections/Brands.astro';
import OwnBrands from '../components/sections/OwnBrands.astro';
import Services from '../components/sections/Services.astro';
import CertificadoPolarizado from '../components/sections/CertificadoPolarizado.astro';
import LaminasSeguridad from '../components/sections/LaminasSeguridad.astro';
import Differentiator from '../components/sections/Differentiator.astro';
import ProductsCta from '../components/sections/ProductsCta.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FAQ from '../components/sections/Faq.astro';
import LocalMap from '../components/sections/LocalMap.astro';
import CtaFinal from '../components/sections/CtaFinal.astro';
import Instagram from '../components/sections/Instagram.astro';
---

<BaseLayout>
  <Hero />
  <PromoBanner
    slides={[
      { src: '/banners/oferta-septiembre-1.webp', alt: 'Super ofertas en todo — Hertz, Pioneer, Recoil, Kenwood, JBL — Fiestas Patrias', href: '/productos', fit: 'contain' },
      { src: '/banners/oferta-septiembre-2.webp', alt: 'Viva Chile — Antocarz Seguridad Automotriz' },
      { src: '/banners/oferta-septiembre-3.webp', alt: 'Protege tu vehículo — Alarmas y seguridad antirrobo', href: '#servicios' },
      { src: '/banners/oferta-septiembre-4.webp', alt: 'La seguridad en tus manos — Cortacorriente y alarmas', href: '#servicios' },
      { src: '/banners/oferta-septiembre-5.webp', alt: 'La seguridad en tus manos — Rastreadores GPS', href: '#servicios' },
    ]}
  />
  <Testimonials />
  <Authority />
  <Brands />
  <div class="hazard-stripes"></div>
  <OwnBrands />
  <Services />

  <div class="hazard-stripes"></div>
  <CertificadoPolarizado />

  <div class="hazard-stripes"></div>
  <LaminasSeguridad />

  <div class="hazard-stripes"></div>
  <Instagram />


  <div class="hazard-stripes"></div>
  <ProductsCta />

  <div class="hazard-stripes"></div>
  <FAQ />
  <LocalMap />
  <CtaFinal />
</BaseLayout>
